# Cloudflare Pages headers
# Mirrors the .htaccess rules for the Apache/UltaHost fallback path.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed filenames change every build, so these are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the shell — a stale index.html points at deleted asset files.
/index.html
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Cache-Control: no-cache, must-revalidate

/robots.txt
  Cache-Control: no-cache, must-revalidate
