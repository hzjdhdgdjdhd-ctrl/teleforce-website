{
  "name": "teleforce",
  "private": true,
  "type": "module",
  "description": "Teleforce Technology — human-powered BPO operating system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:website": "npm run build -w @teleforce/website",
    "deploy:website": "npm run deploy -w @teleforce/website",
    "dev:website": "npm run dev -w @teleforce/website"
  },
  "engines": {
    "node": ">=20"
  }
}
